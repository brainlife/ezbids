# dcm2niix: the one pinned release for the web handler image (handler/Dockerfile) and the desktop app
# (fetch-binaries.sh). Both download the official rordenlab/dcm2niix release asset below, check its sha256,
# bundle it (it runs offline) and fail the build unless `dcm2niix -v` prints DCM2NIIX_VERSION.
# Assets and sha256: the asset digests on https://github.com/rordenlab/dcm2niix/releases/tag/v1.0.20261029
# (published 2026-10-29), checked 2026-11-24. To update: change all lines together (tests/dcm2niix-version.sh
# checks that no other dcm2niix version is written anywhere in the repo).
DCM2NIIX_VERSION=v1.0.20261029
# linux-amd64: x86-64 ELF
DCM2NIIX_ASSET_linux_amd64=dcm2niix_lnx.zip
DCM2NIIX_SHA256_linux_amd64=decc03fe9c08e696700876bd0e28fbc1dda5be11979905dfa5a5e01063cdf758
# darwin-arm64 and darwin-amd64: one universal (x86_64 + arm64) Mach-O
DCM2NIIX_ASSET_darwin_arm64=dcm2niix_mac.zip
DCM2NIIX_SHA256_darwin_arm64=ff8765a5380faa917306c4c10041598a734f298d8fd1dc7cfcf52527bae9c165
DCM2NIIX_ASSET_darwin_amd64=dcm2niix_mac.zip
DCM2NIIX_SHA256_darwin_amd64=ff8765a5380faa917306c4c10041598a734f298d8fd1dc7cfcf52527bae9c165
# windows-amd64: dcm2niix.exe plus the MSVC runtime DLLs it needs (kept next to it)
DCM2NIIX_ASSET_windows_amd64=dcm2niix_win.zip
DCM2NIIX_SHA256_windows_amd64=71ab03724075c2bf95841588a12efa64c89aff5cc52a36b04d40ac378e9c31fd
# linux-arm64: the official release has no asset for it; fetching for linux-arm64 fails
