{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "Node10",
        "types": ["node"],
        "noEmit": true,
        "resolveJsonModule": true
    },
    "ts-node": {
        "esm": false,
        "transpileOnly": true
    },
    "include": ["**/*.ts"],
    "exclude": ["**/*.js"]
}
