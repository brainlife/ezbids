{
    "name": "ezbids",
    "version": "0.0.4",
    "description": "",
    "private": true,
    "main": "index.js",
    "type": "commonjs",
    "workspaces": [
        "ui",
        "electron"
    ],
    "scripts": {
        "uidev": "cd ui && lite-server",
        "transpile": "tsc",
        "dev": "ts-node-dev --respawn --transpile-only ./api/ezbids.ts",
        "prod": "tsc && node ./build/ezbids.js",
        "style-check": "prettier --config .prettierrc.json --check",
        "lint-check": "eslint --ext .ts,.vue,.js",
        "lint-staged": "lint-staged --config .lintstagedrc.json",
        "prepare-husky": "husky install",
        "test": "jest",
        "test:watch": "jest --watch",
        "smoke:bundled": "node scripts/smoke-bundled-runtime.mjs",
        "ui:dev": "npm run dev -w ui",
        "ui:build": "npm run build -w ui",
        "electron:start-dev": "npm run start-dev -w ezbids-electron",
        "electron:pack-test": "npm run fetch-binaries:macos && npm run build:electron -w ezbids-electron && npm run app:dir -w ezbids-electron",
        "electron:pack": "npm run app:build-dist -w ezbids-electron",
        "fetch-binaries:macos": "./fetch-binaries.sh darwin arm64",
        "fetch-binaries:linux": "./fetch-binaries.sh linux amd64",
        "fetch-binaries:windows": "./fetch-binaries.sh windows amd64"
    },
    "author": "",
    "license": "MIT",
    "dependencies": {
        "archiver": "^5.3.0",
        "async": "^3.2.3",
        "bids-validator": "1.14.8",
        "body-parser": "^1.19.2",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "electron-store": "^11.0.2",
        "execa": "^9.6.1",
        "express": "^4.17.3",
        "express-fileupload": "^1.3.1",
        "express-jwt": "^8.4.1",
        "jsonwebtoken": "^9.0.2",
        "mkdirp": "^1.0.4",
        "mongoose": "^6.2.7",
        "multer": "1.4.4-lts.1",
        "nan": "^2.17.0",
        "nocache": "^2.1.0",
        "p-limit": "^6.2.0",
        "range-stream": "^1.1.0",
        "send-seekable": "^1.0.4",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "ts-node-dev": "^2.0.0",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@types/async": "^3.2.12",
        "@types/cors": "^2.8.12",
        "@types/express": "^4.17.13",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.4",
        "@types/node": "^20",
        "@typescript-eslint/eslint-plugin": "^6.9.1",
        "@typescript-eslint/parser": "^6.9.1",
        "eslint": "^8.52.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "lite-server": "^2.6.1",
        "lint-staged": "^15.0.2",
        "prettier": "^3.0.3",
        "ts-jest": "^29.3.4",
        "tsc-watch": "^6.0.4",
        "typescript": "~5.6.3"
    }
}
