{
    "name": "ezbids-electron",
    "version": "1.0.0",
    "description": "electron implementation for ezbids",
    "main": "main.js",
    "scripts": {
        "start": "NODE_ENV=prod ELECTRON_OVERRIDE_DIST_PATH=../node_modules/electron/dist electron .",
        "build:electron-api": "tsc --noCheck -p ../api/tsconfig.json && esbuild ../api/ezbids.ts --bundle --platform=node --format=cjs --outfile=dist/backend.cjs --external:nan --external:electron-store",
        "build:electron-handler": "tsc --noCheck -p ../handler/tsconfig.json && esbuild ../handler/handler.ts --bundle --platform=node --format=cjs --outfile=dist/handler/handler.cjs --external:nan --external:electron-store",
        "build:electron-handler-scripts": "esbuild ../handler/preprocess.ts ../handler/expand.ts ../handler/bids.ts ../handler/convert.ts --bundle --platform=node --format=cjs --outdir=dist/handler --out-extension:.js=.cjs --external:nan --external:electron-store",
        "build:electron-python": "mkdir -p dist/handler/ezBIDS_core && cp ../handler/ezBIDS_core/*.py dist/handler/ezBIDS_core/ && cp ../handler/*.py dist/handler/",
        "build:electron-bids-spec": "mkdir -p dist/bids-specification/src && cp -r ../bids-specification/src/schema dist/bids-specification/src/schema",
        "build:electron-frontend": "(cd ../ui && npm run build:electron)",
        "build:electron": "rm -rf dist && npm run build:electron-api && npm run build:electron-handler && npm run build:electron-handler-scripts && npm run build:electron-python && npm run build:electron-bids-spec && npm run build:electron-frontend && tsc",
        "app:dir": "electron-builder --dir",
        "app:dist": "electron-builder",
        "app:build-dist": "npm run build:electron && npm run app:dist",
        "tsc:watch": "tsc --watch"
    },
    "author": "nicoalee",
    "license": "ISC",
    "dependencies": {
        "bids-validator": "^1.14.8",
        "electron-store": "^11.0.2"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "electron": "^40.3.0",
        "electron-builder": "^26.7.0",
        "esbuild": "^0.27.3",
        "typescript": "^5.0.0"
    },
    "build": {
        "appId": "io.brainlife.ezbids.electron",
        "publish": null,
        "productName": "ezBIDS",
        "directories": {
            "output": "release"
        },
        "asar": false,
        "files": [
            "main.js",
            "preload/**/*.js",
            "dist/backend.cjs",
            "dist/handler/**",
            "dist/bids-specification/**",
            "dist/frontend/**",
            "!node_modules/**/*.ts",
            "!node_modules/**/*.map",
            "!node_modules/**/build/module/**",
            "!node_modules/**/{test,tests,__tests__,testing,spec}/**",
            "!node_modules/**/{example,examples,demo,demos}/**",
            "!node_modules/**/{docs,doc,documentation}/**",
            "!node_modules/**/{CHANGELOG*,HISTORY*,README*,readme*,LICENSE,license,*.md}"
        ],
        "extraResources": [
            {
                "from": "../handler/bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.education",
            "target": [
                {
                    "target": "dmg"
                }
            ],
            "artifactName": "ezbids-desktop-darwin-${arch}.${ext}"
        },
        "win": {
            "target": [
                {
                    "target": "nsis"
                }
            ],
            "artifactName": "ezbids-desktop-windows-${arch}.${ext}"
        },
        "linux": {
            "category": "Science",
            "target": [
                {
                    "target": "AppImage"
                },
                {
                    "target": "deb"
                }
            ],
            "artifactName": "ezbids-desktop-linux-${arch}.${ext}"
        }
    }
}
