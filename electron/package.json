{
    "name": "ezbids-electron",
    "version": "1.0.0",
    "description": "electron implementation for ezbids",
    "main": "main.ts",
    "type": "module",
    "scripts": {
        "start": "NODE_ENV=prod ELECTRON_OVERRIDE_DIST_PATH=../node_modules/electron/dist electron .",
        "build:electron-api": "tsc --noCheck -p ../api/tsconfig.json && esbuild ../api/ezbids.ts --bundle --platform=node --format=cjs --outfile=dist/backend.cjs --external:node-pty --external:nan",
        "build:electron-handler": "tsc --noCheck -p ../handler/tsconfig.json  && esbuild ../handler/handler.ts --bundle --platform=node --format=cjs --outfile=dist/handler.cjs --external:node-pty --external:nan",
        "build:electron-frontend": "(cd ../ui && npm run build:electron)",
        "build:electron": "npm run build:electron-api && npm run build:electron-handler && npm run build:electron-frontend && tsc",
        "app:dir": "electron-builder --dir",
        "app:dist": "electron-builder",
        "tsc:watch": "tsc --watch"
    },
    "author": "nicoalee",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^20.0.0",
        "electron": "^40.3.0",
        "electron-builder": "^26.7.0",
        "esbuild": "^0.27.3",
        "typescript": "^5.0.0"
    },
    "build": {
        "appId": "com.brainlife.ezbids.electron",
        "mac": {
            "category": "public.app-category.education"
        }
    }
}
